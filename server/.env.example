DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Comma-separated Soniox keys for round-robin (shared users)
SONIOX_API_KEYS=key1,key2,key3
# Private key — used only when client passes private=1
SONIOX_PRIVATE_KEY=your_private_key

# ── Account sync (optional Google / Apple login) ──
# Accepted `aud` values for provider ID tokens. OAuth client IDs are public
# identifiers, not secrets. List every client the app may present:
#   iOS client ID, Android client ID, Web client ID.
GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com
# Bundle ID for native Sign in with Apple (plus the Services ID if you enable
# the browser flow for Apple later).
APPLE_CLIENT_IDS=com.silsigan.app
# Desktop browser sign-in only — a Google "Web application" OAuth client.
# Leave unset to disable browser sign-in; native mobile sign-in still works.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Public origin used to build OAuth redirect URIs.
PUBLIC_BASE_URL=https://silsigan.onrender.com
